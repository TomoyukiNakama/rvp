[Desktop Entry]
Type=Application
Name=rvp
GenericName=Video Player
GenericName[ja]=動画プレイヤー
Comment=Play videos with subtitles, playlists and hardware decoding
Comment[ja]=字幕・プレイリスト・ハードウェアデコードに対応した動画プレイヤー
Icon=io.github.TomoyukiNakama.rvp
Exec=rvp %F
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;movie;music;audio;player;subtitles;playlist;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/mp2t;video/ogg;video/x-flv;video/3gpp;audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;audio/x-wav;audio/wav;audio/x-ms-wma;audio/x-aiff;audio/x-matroska;audio/x-mpegurl;application/vnd.apple.mpegurl;
StartupWMClass=rvp
